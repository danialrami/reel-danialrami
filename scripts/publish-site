#!/usr/bin/env bash
# Publish the built artifact (dist/) to the agnostic `site` branch using ONLY git.
# The host (Cloudflare Pages git-integration / Hostinger webhook) subscribes to `site`.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
SITE_BRANCH="${SITE_BRANCH:-site}"
REMOTE="${REMOTE:-$(git config --get remote.origin.url)}"
: "${GIT_SHA:=$(git rev-parse HEAD 2>/dev/null || echo unknown)}"
[ -s dist/index.html ] || { echo "publish-site: dist/index.html missing — run scripts/build first"; exit 1; }
tmp="$(mktemp -d)"; cleanup(){ rm -rf "$tmp"; }; trap cleanup EXIT
cp -R dist/. "$tmp"/
touch "$tmp/.nojekyll"   # keep static hosts from mangling underscore dirs
cd "$tmp"
git init -q && git checkout -q -b "$SITE_BRANCH" && git add -A
git -c user.name="${GIT_AUTHOR_NAME:-site-release}" \
    -c user.email="${GIT_AUTHOR_EMAIL:-site-release@users.noreply.github.com}" \
    commit -qm "site: build from ${GIT_SHA}"
git push -f "$REMOTE" "$SITE_BRANCH"
echo "publish-site: pushed dist/ -> ${SITE_BRANCH}"
